config CLIENT_VMSHM_COMM
	bool "client_comm_vmshm communication device"
	depends on ARM64 && REALM_XSHM
	default n
	help
	  Client side of the RMM-authorized Realm shared queue transport.
	  Pool binding creates the platform device with authenticated channel
	  identity. Notifications require RMM IRQ subscription and ACK_ARM.
	  Host-provided DT windows, memfd and MMIO doorbells are unsupported.


config CLIENT_VMSHM_COMM_HELLO_SELFTEST
	bool "Send client_comm_vmshm hello-world self-test request"
	depends on CLIENT_VMSHM_COMM
	default n
	help
	  Send a "hello_world" request to the proxy side after the client comm
	  driver attaches to the shared transport, then wait for the proxy ACK.

	  Enable only for bring-up/debugging, together with
	  PROXY_VMSHM_COMM_HELLO_SELFTEST in the proxy VM kernel.

config CLIENT_VMSHM_COMM_PERF_SELFTEST
	bool "Run client_comm_vmshm no-op RPC performance self-test"
	depends on CLIENT_VMSHM_COMM
	default n
	help
	  Run a boot-time benchmark that sends no-op RPCs through the vmshm
	  comm path, prints RTT and burst-throughput statistics, and reports
	  IRQ-handler to worker-start latency observed by both guests.

	  Enable only for bring-up/performance debugging, together with
	  PROXY_VMSHM_COMM_PERF_SELFTEST in the proxy VM kernel.
