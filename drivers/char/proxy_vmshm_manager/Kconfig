config PROXY_VMSHM_MANAGER
	bool "proxy vmshm manager shared memory character device"
	depends on ARM64 && REALM_XSHM
	default n
	help
	  Proxy object allocator for RMM-authorized Realm pools.
	  Pool bind/unbind controls backing lifetime; no Host DT window or
	  raw shared-window character device is registered.


config PROXY_VMSHM_MANAGER_SELFTEST
	bool "Check Realm pool permissions and exact object extents"
	depends on PROXY_VMSHM_MANAGER
	default n
	help
	  Run per-domain permission and exact page-extent allocation checks
	  when an RMM-authorized pool is bound.
