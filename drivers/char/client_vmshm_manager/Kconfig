config CLIENT_VMSHM_MANAGER
	bool "client vmshm manager shared memory character device"
	depends on ARM64 && REALM_XSHM
	depends on CLIENT_VMSHM_COMM
	default n
	help
	  Client object view for RMM-authorized Realm pools.
	  Pool bind/unbind controls backing lifetime; no Host DT window or
	  raw shared-window character device is registered.
