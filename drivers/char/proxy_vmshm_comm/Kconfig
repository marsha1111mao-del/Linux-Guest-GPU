config PROXY_VMSHM_COMM
	bool "proxy_comm_vmshm communication device"
	depends on ARM64 && REALM_XSHM
	default n
	help
	  Proxy side of the RMM-authorized Realm shared queue transport.
	  Pool binding creates the platform device with authenticated channel
	  identity. Notifications require RMM IRQ subscription and ACK_ARM.
	  Host-provided DT windows, memfd and MMIO doorbells are unsupported.


config PROXY_VMSHM_COMM_HELLO_SELFTEST
	bool "Register proxy_comm_vmshm hello-world self-test handler"
	depends on PROXY_VMSHM_COMM
	default n
	help
	  Register a small in-kernel handler that waits for the client side to
	  send the string "hello_world" over the vmshm control channel, then
	  prints the received string to the kernel log and replies with an ACK.

	  Enable only for bring-up/debugging.

config PROXY_VMSHM_COMM_PERF_SELFTEST
	bool "Register proxy_comm_vmshm no-op performance self-test handlers"
	depends on PROXY_VMSHM_COMM
	default n
	help
	  Register no-op echo and performance-report handlers used by the
	  client_comm_vmshm boot-time performance self-test.

	  Enable only for bring-up/performance debugging.
